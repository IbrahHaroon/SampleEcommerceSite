# Stripe — get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Database — Supabase PostgreSQL connection string
# Found at: Supabase Dashboard → Project Settings → Database → Connection string (URI)
# Use the "Session mode" pooler URL for Railway (port 5432)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Supabase Auth — used to verify user JWTs on the backend
# Found at: Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Your deployed frontend URL (used for Stripe redirect URLs and CORS)
FRONTEND_URL=https://your-app.vercel.app

# Additional CORS origins (comma-separated), if needed
# ALLOWED_ORIGINS=https://preview.your-app.vercel.app
